{
  "name": "@johnhenry/html-modules",
  "version": "0.0.0",
  "description": "Declarative HTML modules: export components from ordinary HTML, import them with <html-import src as>, and optionally compile them to ES modules.",
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "homepage": "https://opensource.johnhenry.me/html-modules/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/html-modules.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/html-modules/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "sideEffects": [
    "./src/browser.js"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./runtime": {
      "types": "./types/runtime.d.ts",
      "default": "./src/runtime.js"
    },
    "./compiler": {
      "types": "./types/compiler.d.ts",
      "default": "./src/compiler.js"
    },
    "./dev": {
      "types": "./types/dev-server.d.ts",
      "default": "./src/dev-server.js"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./safe-fragment": {
      "types": "./types/safe-fragment.d.ts",
      "default": "./src/safe-fragment.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "html-module": "./bin/html-module.js"
  },
  "files": [
    "src",
    "types",
    "bin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check.js",
    "types": "tsc -p tsconfig.types.json",
    "build": "node scripts/check.js",
    "examples": "for f in examples/[0-9]*.mjs; do node \"$f\" || exit 1; done",
    "example:01": "node examples/01-a-module-reads-into-a-json-record.mjs",
    "example:02": "node examples/02-tags-are-namespace-delimiter-export.mjs",
    "example:03": "node examples/03-compiled-output-is-a-plain-es-module.mjs",
    "example:04": "node examples/04-invalid-modules-fail-with-a-named-syntax-error.mjs",
    "example:05": "node examples/05-html-import-registers-and-upgrades-in-place.mjs",
    "example:06": "node examples/06-lazy-import-fetches-on-first-use.mjs",
    "example:07": "node examples/07-hot-reload-swaps-components-under-live-elements.mjs",
    "examples:compile": "node scripts/compile-examples.js",
    "types:check": "tsc -p tsconfig.usage.json",
    "vendor:safe-fragment": "node scripts/vendor-safe-fragment.js",
    "test:browser": "playwright test",
    "bench": "node scripts/bench.js"
  },
  "keywords": [
    "html-modules",
    "web-components",
    "custom-elements",
    "templates",
    "esm",
    "html-import",
    "declarative",
    "shadow-dom",
    "compiler"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@johnhenry/safe-fragment": "*"
  },
  "peerDependenciesMeta": {
    "@johnhenry/safe-fragment": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/safe-fragment": "git+https://github.com/johnhenry/safe-fragment.git#ee01b49b28278e1053358200a77e5a4c6de511ad",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "linkedom": "^0.18.13",
    "parse5": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "types": "./types/index.d.ts"
}
