{
  "name": "@johnhenry/html-modules",
  "version": "0.0.0",
  "description": "Declarative HTML modules: export components from ordinary HTML, import them with <html-import src as>, and optionally compile them to ES modules.",
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "homepage": "https://opensource.johnhenry.me/html-modules/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/html-modules.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/html-modules/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "sideEffects": [
    "./src/browser.js"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./browser": "./src/browser.js",
    "./runtime": "./src/runtime.js",
    "./compiler": "./src/compiler.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "html-module": "./bin/html-module.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js",
    "examples": "for f in examples/[0-9]*.mjs; do node \"$f\" || exit 1; done",
    "example:01": "node examples/01-a-module-reads-into-a-json-record.mjs",
    "example:02": "node examples/02-tags-are-namespace-delimiter-export.mjs",
    "example:03": "node examples/03-compiled-output-is-a-plain-es-module.mjs",
    "example:04": "node examples/04-invalid-modules-fail-with-a-named-syntax-error.mjs",
    "example:05": "node examples/05-html-import-registers-and-upgrades-in-place.mjs",
    "example:06": "node examples/06-lazy-import-fetches-on-first-use.mjs",
    "examples:compile": "node scripts/compile-examples.js"
  },
  "keywords": [
    "html-modules",
    "web-components",
    "custom-elements",
    "templates",
    "esm",
    "html-import",
    "declarative",
    "shadow-dom",
    "compiler"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
