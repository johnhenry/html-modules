{
  "name": "html-modules",
  "version": "0.0.0",
  "description": "Declarative HTML modules: export components from ordinary HTML, import them with <html-import src as>, and optionally compile them to ES modules.",
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": [
    "./src/browser.js"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./browser": "./src/browser.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js"
  },
  "keywords": [
    "html-modules",
    "web-components",
    "custom-elements",
    "templates",
    "esm"
  ],
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
